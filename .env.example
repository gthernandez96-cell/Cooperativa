# Variables de ejemplo — copiar como .env y completar valores reales
SECRET_KEY=cambia-este-valor-por-uno-seguro
FLASK_ENV=development
FLASK_DEBUG=0

# Fase 1 PostgreSQL (mantener sqlite mientras se migra la capa SQL)
DB_BACKEND=sqlite
DATABASE_URL=
SQLITE_PATH=./cooperativa.db

# Soporte de HTTPS (Local y Producción)
USE_HTTPS=False
FORCE_HTTPS=False
